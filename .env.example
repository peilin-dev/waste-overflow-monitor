# ─── Database (本地开发) ────────────────────────────────────────────────────────
# 本地直接填 DATABASE_URL，把 your_password 替换成你的 MySQL root 密码
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/waste_monitor

# ─── Database (Docker Compose 生产环境用，本地开发不需要改) ──────────────────────
MYSQL_ROOT_PASSWORD=your_root_password
DB_USER=waste_user
DB_PASSWORD=your_db_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret_key

# ─── Sensor API Key (optional) ────────────────────────────────────────────────
# SENSOR_API_KEY=sk_sensor_your_key_here
