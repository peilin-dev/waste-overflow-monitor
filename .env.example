# ─── Database ─────────────────────────────────────────────────────────────────
# async MySQL URL (requires aiomysql driver)
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/waste_monitor

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed frontend origins (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ─── Sensor API Key (optional) ────────────────────────────────────────────────
# If set, POST /api/bins/{id}/fill requires header: X-Sensor-Key: <value>
# Leave unset (or comment out) to allow open access in development
# SENSOR_API_KEY=sk_sensor_your_key_here
